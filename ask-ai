#!/usr/bin/env bash

# ask-ai - A lightweight Bash CLI for AI API interactions

set -e

VERSION="1.0.0"
CONFIG_DIR="$HOME/.ask-ai"
CONFIG_FILE="$CONFIG_DIR/config.json"
LOGS_DIR="./ask-ai-logs"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging function
log_error() {
    local error_message="$1"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local log_file="$LOGS_DIR/ask-ai-error-${timestamp}.log"
    
    mkdir -p "$LOGS_DIR"
    chmod 700 "$LOGS_DIR" 2>/dev/null
    local sanitized=$(sanitize_error "$error_message")
    echo "[$timestamp] ERROR: $sanitized" >> "$log_file"
    chmod 600 "$log_file" 2>/dev/null
    echo -e "${RED}Error logged to: $log_file${NC}" >&2
}

# Check dependencies
check_dependencies() {
    local missing_deps=""
    
    if ! command -v curl >/dev/null 2>&1; then
        missing_deps="curl"
    fi
    
    if ! command -v jq >/dev/null 2>&1; then
        if [ -n "$missing_deps" ]; then
            missing_deps="$missing_deps jq"
        else
            missing_deps="jq"
        fi
    fi
    
    if [ -n "$missing_deps" ]; then
        echo -e "${RED}Error: Missing required dependencies: $missing_deps${NC}" >&2
        echo "Please install: $missing_deps" >&2
        exit 1
    fi
}

# Set secure file permissions
set_secure_permissions() {
    local file="$1"
    if [ -f "$file" ]; then
        chmod 600 "$file" 2>/dev/null
    fi
}

# Check config file security
check_config_security() {
    if [ ! -f "$CONFIG_FILE" ]; then
        return
    fi
    
    local perms=$(stat -c "%a" "$CONFIG_FILE" 2>/dev/null || stat -f "%A" "$CONFIG_FILE" 2>/dev/null)
    if [ -n "$perms" ] && [ "$perms" != "600" ]; then
        echo -e "${YELLOW}Warning: Config file has insecure permissions ($perms)${NC}" >&2
        echo -e "${YELLOW}Run: chmod 600 $CONFIG_FILE${NC}" >&2
        echo -e "${YELLOW}This restricts access to your API keys.${NC}" >&2
    fi
}

# Sanitize error message to avoid leaking sensitive data
sanitize_error() {
    local error="$1"
    # Remove potential API keys from error messages
    echo "$error" | sed 's/sk-[a-zA-Z0-9]*/[API_KEY_REDACTED]/g' | sed 's/Bearer [^ ]*/Bearer [REDACTED]/g'
}

# Print version
print_version() {
    echo "ask-ai v$VERSION"
    echo "Author: live-by-unix"
    echo "GitHub: https://github.com/live-by-unix/ask-ai"
}

# Print help
print_help() {
    cat << EOF
ask-ai - A lightweight Bash CLI for AI API interactions

USAGE:
    ask-ai <command> [options]

COMMANDS:
    config              Configure API settings (interactive wizard)
    chat <model>        Send a chat request to the configured API
    --version, --v      Print version information
    --help, -h          Show this help message

CONFIG WIZARD:
    The config command supports three request types:
    1. OpenAI-style - Requires: model, temperature, max_tokens, api_key, endpoint
    2. Anthropic-style - Requires: model, system_prompt, max_tokens, api_key, endpoint
    3. Ollama-local - Requires: port, model (no API key needed)

CHAT COMMAND:
    ask-ai chat <model-local-name>
    
    Options:
        --json          Output structured JSON instead of Markdown
    
    Examples:
        # Interactive chat
        ask-ai chat gpt-4
        
        # Pipe input
        echo "Explain quantum computing" | ask-ai chat claude-3
        
        # Pipe to file
        cat prompt.md | ask-ai chat gpt-5.5 > response.md
        
        # JSON output
        ask-ai chat gpt-4 --json

PIPING SUPPORT:
    Both config and chat commands support piping:
    
    # Config with piped model name
    echo "claude-opus-4.8" | ask-ai config
    
    # Chat with piped prompt
        cat prompt.md | ask-ai chat gpt-4

CONFIG FILE:
    Location: ~/.ask-ai/config.json
    
ERROR HANDLING:
    Exit codes:
        0 - Success
        1 - Config error
        2 - Network error
        3 - API error
    
    Error logs are automatically created in: ask-ai-logs/

EOF
}

# Read config
read_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo -e "${RED}Error: Config file not found at $CONFIG_FILE${NC}" >&2
        echo "Please run 'ask-ai config' to set up your configuration." >&2
        log_error "Config file not found: $CONFIG_FILE"
        exit 1
    fi
    
    check_config_security
    
    if ! jq empty "$CONFIG_FILE" 2>/dev/null; then
        echo -e "${RED}Error: Invalid JSON in config file${NC}" >&2
        log_error "Invalid JSON in config file: $CONFIG_FILE"
        exit 1
    fi
    
    cat "$CONFIG_FILE"
}

# Config wizard
config_wizard() {
    local piped_input=""
    
    # Check for piped input
    if [ ! -t 0 ]; then
        piped_input=$(cat)
    fi
    
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR" 2>/dev/null
    
    echo -e "${BLUE}=== ask-ai Configuration Wizard ===${NC}"
    echo ""
    echo "Select request type:"
    echo "1) OpenAI-style"
    echo "2) Anthropic-style"
    echo "3) Ollama-local"
    echo ""
    
    read -p "Enter choice (1-3): " choice
    
    case $choice in
        1)
            configure_openai "$piped_input"
            ;;
        2)
            configure_anthropic "$piped_input"
            ;;
        3)
            configure_ollama "$piped_input"
            ;;
        *)
            echo -e "${RED}Invalid choice${NC}" >&2
            log_error "Invalid config choice: $choice"
            exit 1
            ;;
    esac
}

configure_openai() {
    local piped_input="$1"
    
    echo ""
    echo -e "${GREEN}Configuring OpenAI-style API${NC}"
    echo ""
    
    local model="$piped_input"
    if [ -z "$model" ]; then
        read -p "Model name (e.g., gpt-4): " model
    fi
    
    read -p "Temperature (0.0-2.0, default 0.7): " temperature
    temperature="${temperature:-0.7}"
    
    read -p "Max tokens (default 2048): " max_tokens
    max_tokens="${max_tokens:-2048}"
    
    read -p "API key: " api_key
    
    read -p "Endpoint URL (default https://api.openai.com/v1/chat/completions): " endpoint
    endpoint="${endpoint:-https://api.openai.com/v1/chat/completions}"
    
    local config=$(jq -n \
        --arg request_type "openai" \
        --arg model "$model" \
        --argjson temperature "$temperature" \
        --argjson max_tokens "$max_tokens" \
        --arg api_key "$api_key" \
        --arg endpoint "$endpoint" \
        '{
            request_type: $request_type,
            model: $model,
            temperature: $temperature,
            max_tokens: $max_tokens,
            api_key: $api_key,
            endpoint: $endpoint
        }')
    
    echo "$config" > "$CONFIG_FILE"
    set_secure_permissions "$CONFIG_FILE"
    echo -e "${GREEN}Configuration saved to $CONFIG_FILE${NC}"
    echo -e "${YELLOW}Security notice: Your API key is stored in plain text.${NC}" >&2
    echo -e "${YELLOW}Ensure file permissions are restrictive: chmod 600 $CONFIG_FILE${NC}" >&2
}

configure_anthropic() {
    local piped_input="$1"
    
    echo ""
    echo -e "${GREEN}Configuring Anthropic-style API${NC}"
    echo ""
    
    local model="$piped_input"
    if [ -z "$model" ]; then
        read -p "Model name (e.g., claude-3-opus-20240229): " model
    fi
    
    read -p "System prompt (optional, press Enter to skip): " system_prompt
    
    read -p "Max tokens (default 4096): " max_tokens
    max_tokens="${max_tokens:-4096}"
    
    read -p "API key: " api_key
    
    read -p "Endpoint URL (default https://api.anthropic.com/v1/messages): " endpoint
    endpoint="${endpoint:-https://api.anthropic.com/v1/messages}"
    
    local config=$(jq -n \
        --arg request_type "anthropic" \
        --arg model "$model" \
        --arg system_prompt "$system_prompt" \
        --argjson max_tokens "$max_tokens" \
        --arg api_key "$api_key" \
        --arg endpoint "$endpoint" \
        '{
            request_type: $request_type,
            model: $model,
            system_prompt: $system_prompt,
            max_tokens: $max_tokens,
            api_key: $api_key,
            endpoint: $endpoint
        }')
    
    echo "$config" > "$CONFIG_FILE"
    set_secure_permissions "$CONFIG_FILE"
    echo -e "${GREEN}Configuration saved to $CONFIG_FILE${NC}"
    echo -e "${YELLOW}Security notice: Your API key is stored in plain text.${NC}" >&2
    echo -e "${YELLOW}Ensure file permissions are restrictive: chmod 600 $CONFIG_FILE${NC}" >&2
}

configure_ollama() {
    local piped_input="$1"
    
    echo ""
    echo -e "${GREEN}Configuring Ollama-local API${NC}"
    echo ""
    
    read -p "Port (default 11434): " port
    port="${port:-11434}"
    
    local model="$piped_input"
    if [ -z "$model" ]; then
        read -p "Model name (e.g., llama2): " model
    fi
    
    local config=$(jq -n \
        --arg request_type "ollama" \
        --argjson port "$port" \
        --arg model "$model" \
        '{
            request_type: $request_type,
            port: $port,
            model: $model
        }')
    
    echo "$config" > "$CONFIG_FILE"
    set_secure_permissions "$CONFIG_FILE"
    echo -e "${GREEN}Configuration saved to $CONFIG_FILE${NC}"
}

# Chat command
chat_command() {
    local model_name="$1"
    shift
    local output_json=false
    
    # Parse flags
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --json)
                output_json=true
                shift
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}" >&2
                exit 1
                ;;
        esac
    done
    
    # Read config
    local config=$(read_config)
    local request_type=$(echo "$config" | jq -r '.request_type')
    
    # Read prompt from stdin or argument
    local prompt=""
    if [ ! -t 0 ]; then
        prompt=$(cat)
    else
        echo "Enter your prompt (Ctrl+D to finish):"
        prompt=$(cat)
    fi
    
    if [ -z "$prompt" ]; then
        echo -e "${RED}Error: No prompt provided${NC}" >&2
        log_error "No prompt provided for chat command"
        exit 1
    fi
    
    # Send request based on type
    case $request_type in
        openai)
            send_openai_request "$config" "$model_name" "$prompt" "$output_json"
            ;;
        anthropic)
            send_anthropic_request "$config" "$model_name" "$prompt" "$output_json"
            ;;
        ollama)
            send_ollama_request "$config" "$model_name" "$prompt" "$output_json"
            ;;
        *)
            echo -e "${RED}Error: Unknown request type: $request_type${NC}" >&2
            log_error "Unknown request type: $request_type"
            exit 1
            ;;
    esac
}

send_openai_request() {
    local config="$1"
    local model_name="$2"
    local prompt="$3"
    local output_json="$4"
    
    local model=$(echo "$config" | jq -r '.model')
    local temperature=$(echo "$config" | jq -r '.temperature')
    local max_tokens=$(echo "$config" | jq -r '.max_tokens')
    local api_key=$(echo "$config" | jq -r '.api_key')
    local endpoint=$(echo "$config" | jq -r '.endpoint')
    
    local payload=$(jq -n \
        --arg model "$model_name" \
        --argjson temperature "$temperature" \
        --argjson max_tokens "$max_tokens" \
        --arg content "$prompt" \
        '{
            model: $model,
            temperature: $temperature,
            max_tokens: $max_tokens,
            messages: [{role: "user", content: $content}]
        }')
    
    local response
    if ! response=$(curl -s -w "\n%{http_code}" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $api_key" \
        -d "$payload" \
        "$endpoint" 2>&1); then
        echo -e "${RED}Error: Network request failed${NC}" >&2
        log_error "Network request failed for OpenAI: $response"
        exit 2
    fi
    
    local http_code=$(echo "$response" | tail -n1)
    local body=$(echo "$response" | sed '$d')
    
    if [ "$http_code" != "200" ]; then
        echo -e "${RED}Error: API returned HTTP $http_code${NC}" >&2
        echo "Response: $body" >&2
        log_error "OpenAI API error HTTP $http_code: $body"
        exit 3
    fi
    
    if [ "$output_json" = true ]; then
        echo "$body"
    else
        local content=$(echo "$body" | jq -r '.choices[0].message.content // empty')
        if [ -z "$content" ]; then
            echo -e "${RED}Error: No content in API response${NC}" >&2
            log_error "No content in OpenAI response: $body"
            exit 3
        fi
        echo "$content"
    fi
}

send_anthropic_request() {
    local config="$1"
    local model_name="$2"
    local prompt="$3"
    local output_json="$4"
    
    local model=$(echo "$config" | jq -r '.model')
    local system_prompt=$(echo "$config" | jq -r '.system_prompt')
    local max_tokens=$(echo "$config" | jq -r '.max_tokens')
    local api_key=$(echo "$config" | jq -r '.api_key')
    local endpoint=$(echo "$config" | jq -r '.endpoint')
    
    local payload=$(jq -n \
        --arg model "$model_name" \
        --argjson max_tokens "$max_tokens" \
        --arg content "$prompt" \
        --arg system_prompt "$system_prompt" \
        '{
            model: $model,
            max_tokens: $max_tokens,
            messages: [{role: "user", content: $content}]
        } + (if $system_prompt != "" then {system: $system_prompt} else {} end)')
    
    local response
    if ! response=$(curl -s -w "\n%{http_code}" \
        -H "Content-Type: application/json" \
        -H "x-api-key: $api_key" \
        -H "anthropic-version: 2023-06-01" \
        -d "$payload" \
        "$endpoint" 2>&1); then
        echo -e "${RED}Error: Network request failed${NC}" >&2
        log_error "Network request failed for Anthropic: $response"
        exit 2
    fi
    
    local http_code=$(echo "$response" | tail -n1)
    local body=$(echo "$response" | sed '$d')
    
    if [ "$http_code" != "200" ]; then
        echo -e "${RED}Error: API returned HTTP $http_code${NC}" >&2
        echo "Response: $body" >&2
        log_error "Anthropic API error HTTP $http_code: $body"
        exit 3
    fi
    
    if [ "$output_json" = true ]; then
        echo "$body"
    else
        local content=$(echo "$body" | jq -r '.content[0].text // empty')
        if [ -z "$content" ]; then
            echo -e "${RED}Error: No content in API response${NC}" >&2
            log_error "No content in Anthropic response: $body"
            exit 3
        fi
        echo "$content"
    fi
}

send_ollama_request() {
    local config="$1"
    local model_name="$2"
    local prompt="$3"
    local output_json="$4"
    
    local port=$(echo "$config" | jq -r '.port')
    local model=$(echo "$config" | jq -r '.model')
    local endpoint="http://localhost:$port/api/chat"
    
    local payload=$(jq -n \
        --arg model "$model_name" \
        --arg prompt "$prompt" \
        --argjson stream false \
        '{
            model: $model,
            prompt: $prompt,
            stream: $stream
        }')
    
    local response
    if ! response=$(curl -s -w "\n%{http_code}" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "$endpoint" 2>&1); then
        echo -e "${RED}Error: Network request failed${NC}" >&2
        log_error "Network request failed for Ollama: $response"
        exit 2
    fi
    
    local http_code=$(echo "$response" | tail -n1)
    local body=$(echo "$response" | sed '$d')
    
    if [ "$http_code" != "200" ]; then
        echo -e "${RED}Error: API returned HTTP $http_code${NC}" >&2
        echo "Response: $body" >&2
        log_error "Ollama API error HTTP $http_code: $body"
        exit 3
    fi
    
    if [ "$output_json" = true ]; then
        echo "$body"
    else
        local content=$(echo "$body" | jq -r '.message.content // empty')
        if [ -z "$content" ]; then
            echo -e "${RED}Error: No content in API response${NC}" >&2
            log_error "No content in Ollama response: $body"
            exit 3
        fi
        echo "$content"
    fi
}

# Main
main() {
    check_dependencies
    check_config_security
    
    if [ -z "$1" ]; then
        echo -e "${RED}Error: No command specified${NC}" >&2
        echo "Run 'ask-ai --help' for usage information." >&2
        exit 1
    fi
    
    case "$1" in
        config)
            config_wizard
            ;;
        chat)
            if [ -z "$2" ]; then
                echo -e "${RED}Error: Model name required for chat command${NC}" >&2
                echo "Usage: ask-ai chat <model-name> [--json]" >&2
                exit 1
            fi
            shift 2
            chat_command "$2" "$@"
            ;;
        --version|--v)
            print_version
            ;;
        --help|-h)
            print_help
            ;;
        *)
            echo -e "${RED}Error: Unknown command: $1${NC}" >&2
            echo "Run 'ask-ai --help' for usage information." >&2
            exit 1
            ;;
    esac
}

main "$@"
